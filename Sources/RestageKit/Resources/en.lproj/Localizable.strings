/* 사용법 */
"cli.usage" = "restage — a workspace restore tool\n\nUsage:\n  restage new <name>\n  restage open <name|path>\n  restage list\n  restage menubar\n  restage probe [--slot <slot>] [--app <name>] [--fullscreen] [--cold]\n\nnew:\n  Reads the windows you have open and saves them as a workspace\n  Edit the list it shows, then press Enter to save\n\nopen options:\n  <name|path>     A workspace name, or a path to a config file\n                  Names are looked up in ~/.config/restage/<name>.yaml\n\nmenubar:\n  Puts an icon in the menu bar; click a workspace to run it\n  Choose Quit from its menu to stop it\n\nprobe options:\n  --slot <slot>   Where to place windows. Defaults to left-half\n  --app <name>    Check one app. Defaults to every running app\n  --fullscreen    Also check the switch to full screen after placing\n  --cold          Also check a cold start. This force quits the target app,\n                  so --app is required and it asks before running";
